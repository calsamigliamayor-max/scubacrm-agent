# Copia este archivo a ".env" y rellena tu clave. NUNCA la pegues en chats.
ANTHROPIC_API_KEY=pon-aqui-tu-clave

# Modelo (opcional)
MODEL=claude-sonnet-5
PORT=3010

# ─── INTERRUPTOR ───────────────────────────────────────────────────────────
# simulated (por defecto) = aislado, no toca ningún CRM. Seguro para la demo.
# live                    = el agente CREA/CANCELA/MODIFICA reservas de verdad en el CRM.
AGENT_MODE=simulated

# Solo se usan en modo live:
BACKEND_URL=https://scubacrm-backend-production.up.railway.app
DEMO_PHONE=+34600000000

# Clave compartida con el backend (misma variable AGENT_SECRET en Railway).
# Autentica las llamadas servidor-a-servidor del agente contra el CRM.
AGENT_SECRET=pon-aqui-la-clave-compartida-con-el-backend

# ─── Twilio (WhatsApp real) ─────────────────────────────────────────────────
# Solo se usan en modo live. El webhook que recibe los mensajes entrantes es
# POST /webhook/whatsapp — esa es la URL que hay que pegar en la configuración
# del Sandbox (o del número real) en la consola de Twilio.
TWILIO_ACCOUNT_SID=pon-aqui-tu-account-sid
TWILIO_AUTH_TOKEN=pon-aqui-tu-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886
